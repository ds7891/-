+  <string name="qingshui_features_whitewash_level_desc">Light only swaps words. Standard also compresses imperative sentences into noun phrases (recommended). Strong adds softening and punctuation cleanup, for endpoints with especially strict moderation.</string>
+  <string name="qingshui_features_whitewash_level_light">Light · word swap only</string>
+  <string name="qingshui_features_whitewash_level_standard">Standard · word swap + noun phrases</string>
